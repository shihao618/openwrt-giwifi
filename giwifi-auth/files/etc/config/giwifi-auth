config giwifi 'main'
	option enabled '0'
	option base_url 'http://10.189.1.3'
	option interval '30'
	option iface_restart_enabled '0'
	option iface_restart_time '04:00'
	option ua3f_sync_ua ''
	# 自动用启用账号绑定的接口构建原生 ECMP 默认路由。
	# 使用前必须停用 mwan3。
	option ecmp_enabled '1'

# 以下两个空段仅用于 LuCI 的“运行状态 / 日志”选项卡，无配置项。
config status 'status'
config log 'log'
