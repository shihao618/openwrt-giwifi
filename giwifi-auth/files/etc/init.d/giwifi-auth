#!/bin/sh /etc/rc.common
# GiWiFi 校园网自动登录守护进程（procd，多账号版）
# shellcheck disable=SC2034,SC3043  # USE_PROCD/START/STOP 由 rc.common 使用；ash 支持 local

USE_PROCD=1
START=95
STOP=10

start_service() {
    local enabled

    # Rebuild per-account policy tables and the LAN ECMP route from UCI.
    # This is idempotent and also removes stale routes when disabled.
    [ -x /usr/sbin/giwifi-policy ] && /usr/sbin/giwifi-policy apply 2>/dev/null || true

    config_load 'giwifi-auth'
    config_get_bool enabled 'main' enabled '0'
    [ "$enabled" = "1" ] || return 0

    # 检查是否有至少一个启用的账号（has_account 需跨函数共享，故不加 local）
    has_account=0
    config_foreach _check_account account
    [ "$has_account" = "1" ] || {
        logger -t giwifi-auth '未配置已启用的账号，跳过启动'
        return 0
    }

    procd_open_instance
    procd_set_param command /usr/bin/giwifi-auth run
    # 不生成 .pyc，避免 /usr/bin 下残留 __pycache__
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    # respawn 参数：threshold=3600 一小时内最多重启 threshold/retry 次；timeout=5 退出后等 5s 重启
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

_check_account() {
    local cfg="$1"
    local en
    config_get_bool en "$cfg" enabled '1'
    local user
    config_get user "$cfg" username ''
    [ "$en" = "1" ] && [ -n "$user" ] && has_account=1
}

service_triggers() {
    # 官方 UCI 配置变更机制：LuCI「保存并应用」提交后会调用 /sbin/reload_config，
    # procd 据此触发本脚本的 reload，按新配置重启守护进程。
    procd_add_reload_trigger 'giwifi-auth'
}

reload_service() {
    # 保存配置时同步全局 UA3F UA（幂等；未安装/未配置/未变化时立即返回），
    # 再重启守护实例：账号/开关等运行参数只在启动时读取。
    /usr/bin/giwifi-auth sync-ua3f 2>/dev/null || true
    stop
    start
}

stop_service() {
    [ -x /usr/sbin/giwifi-policy ] && /usr/sbin/giwifi-policy cleanup 2>/dev/null || true
}
