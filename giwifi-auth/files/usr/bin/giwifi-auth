#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""giwifi-auth — GiWiFi 校园网自动登录（OpenWrt 版，多账号，纯标准库，headless）。

子命令:
  giwifi-auth login [name]     立即登录（不指定 name 则登录所有已启用账号）
  giwifi-auth logout [name]    注销下线（不指定 name 则注销所有账号）
  giwifi-auth status           查询所有账号在线状态与在线时长
  giwifi-auth check            检查所有账号在线状态（0=全部在线, 1=有掉线, 2=异常）
  giwifi-auth log              查看最近 50 条本地认证日志
  giwifi-auth sync-ua3f        保存配置时调用：把全局 UA3F UA 同步给 ua3f 插件
  giwifi-auth check-config     保存后校验：接口唯一性（0=通过, 1=重复绑定）
  giwifi-auth run              多线程守护：每账号独立轮询，掉线自动重登

配置文件 /etc/config/giwifi-auth（UCI 格式）:
  config giwifi 'main'          全局配置
    option enabled '0/1'        启用守护
    option base_url '...'       Portal 基地址
    option interval '30'        轮询间隔秒
    option iface_restart_enabled '0/1'   定时重启接口开关
    option iface_restart_time '04:00'   每天重启接口的时间（HH:MM）
    option ua3f_sync_ua ''      同步给 UA3F 的终端类型（windows/ipad/iphone/android；空则不动 UA3F；保存时同步）
  config account 'name'         单个账号（可多个）
    option enabled '0/1'        启用该账号
    option interface 'eth0'     绑定的网络接口（认证请求从此接口发出）
    option username '...'       账号
    option password '...'       密码
    option device_type 'windows' 终端类型: ipad/iphone/windows/android
    option device_ua '...'      自定义 UA（非空时优先于终端类型）
    option auto_rebind '0/1'    自动换绑 MAC

环境变量:
  GIWIFI_UCI_PATH  覆盖 UCI 配置文件路径（测试用，默认 /etc/config/giwifi-auth）

协议：Web authLogin JS 流
  GET /gportal/web/login -> 解析 #frmLogin -> AES-128-CBC(ZeroPadding)
  POST /gportal/web/authLogin?round=N {data, iv}  -> status==1 成功
  在线判定: POST /gportal/web/queryAuthState {userIp, sign} -> status==1 在线
"""
import os
import sys
import re
import json
import time
import base64
import random
import socket
import struct
import errno
import html.parser
import urllib.parse
import http.client
import subprocess
import threading

WEB_AES_KEY = b"1234567887654321"
LOGIN_PATH = "/gportal/web/login?has_reload=1&pagetype=login&logintype=1"

# 本地认证日志：滚动保留最近 LOG_KEEP 条，超过 LOG_TRIM 条时裁剪。
# GIWIFI_LOG_PATH 仅用于测试/调试（与 GIWIFI_UCI_PATH 同一约定）。
LOG_PATH = os.environ.get("GIWIFI_LOG_PATH", "/var/log/giwifi-auth.log")
LOG_KEEP = 50
LOG_TRIM = 100
_BEIJING_OFFSET_SECONDS = 8 * 3600

# ---------------------------------------------------------------------------
# 配置：直接读取 UCI 文件（/etc/config/giwifi-auth）。
# main section 为全局参数，多个 account section 为各自绑定接口的账号。
# ---------------------------------------------------------------------------
_UCI_PATH = os.environ.get("GIWIFI_UCI_PATH", "/etc/config/giwifi-auth")
_UCI_CONF = os.path.basename(_UCI_PATH)  # UCI 包名，用于 uci CLI 反查

# Linux 接口名安全字符集：用于拒绝路径穿越/选项注入类配置值。
_IFACE_NAME_RE = re.compile(r"^[A-Za-z0-9_.:@-]+$")


def _valid_iface_name(iface):
    return bool(iface) and not iface.startswith("-") and \
        _IFACE_NAME_RE.match(iface) is not None


def _load_uci_config(path=_UCI_PATH):
    """解析 UCI 文件，返回 {section_name: {".type": 段类型, option: value}}。

    按 UCI 语法处理引号与转义：
      - 单引号值 `'a'\''b'` 还原为 `a'b`；
      - 双引号值还原 `\"` 与 `\\`；
      - 无引号值直接取用。
    section 行形如 `config type 'name'`，name 作为键，type 存入 `".type"`。
    匿名段（LuCI「添加账号」生成）形如 `config type`（**无段名**，落盘时 libuci 不写名字），
    必须同样解析并按 `@type[序号]` 命名，否则整段会被丢弃、插件看不到该账号。
    """
    sections = {}
    cur = None
    anon_seq = {}
    if not os.path.exists(path):
        return sections
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                m = re.match(r"\s*config\s+(\S+)\s+['\"]?(\S+)['\"]?\s*$", line)
                if m:
                    cur = m.group(2).strip("'\"")
                    sec = sections.setdefault(cur, {})
                    sec[".type"] = m.group(1).strip("'\"")
                    continue
                m = re.match(r"\s*config\s+(\S+)\s*$", line)
                if m:
                    sec_type = m.group(1).strip("'\"")
                    idx = anon_seq.get(sec_type, 0)
                    while "@%s[%d]" % (sec_type, idx) in sections:
                        idx += 1
                    anon_seq[sec_type] = idx + 1
                    cur = "@%s[%d]" % (sec_type, idx)
                    sec = sections.setdefault(cur, {})
                    sec[".type"] = sec_type
                    continue
                m = re.match(r"\s*option\s+([^\s]+)\s+(.*?)\s*$", line)
                if m and cur is not None:
                    val = m.group(2).strip()
                    if len(val) >= 2 and val[0] == val[-1] and val[0] in "'\"":
                        quote = val[0]
                        val = val[1:-1]
                        if quote == "'":
                            val = val.replace("'\\''", "'")
                        else:
                            val = val.replace('\\"', '"').replace("\\\\", "\\")
                    sections[cur][m.group(1)] = val
    except (OSError, UnicodeDecodeError):
        pass
    return sections


def _register_idna_fallback():
    """OpenWrt python3-light 拆包缺 encodings.idna（无 python3-encodings 包）。
    Python 3.13 的 socket.getaddrinfo 会无条件对主机名执行 encode('idna')，
    缺失时任何网络连接都抛 LookupError。注册最小 idna 兼容编码
    （仅处理 ASCII 主机名/IP，足够本脚本使用）。"""
    try:
        "a".encode("idna")
        return  # 系统已提供 idna
    except LookupError:
        pass

    def _enc(s, errors="strict"):
        if errors != "strict":
            raise LookupError("idna fallback 仅支持 strict")
        return s.encode("ascii"), len(s)

    def _dec(b, errors="strict"):
        if errors != "strict":
            raise LookupError("idna fallback 仅支持 strict")
        return b.decode("ascii"), len(b)

    import codecs as _codecs
    _codecs.register(
        lambda name: _codecs.CodecInfo(name="idna", encode=_enc, decode=_dec)
        if name == "idna" else None)


_register_idna_fallback()

# 终端类型 -> UA 预设（均走 Web authLogin 流）
_UA_IPAD = ("Mozilla/5.0 (iPad; CPU OS 17_5 like Mac OS X) "
            "AppleWebKit/605.1.15 (KHTML, like Gecko) "
            "Version/17.5 Mobile/15E148 Safari/604.1")
UA_PRESETS = {
    "ipad": _UA_IPAD,
    "iphone": ("Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) "
               "AppleWebKit/605.1.15 (KHTML, like Gecko) "
               "Version/17.5 Mobile/15E148 Safari/604.1"),
    "windows": ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/124.0.0.0 Safari/537.36"),
    "android": ("Mozilla/5.0 (Linux; Android 14; Pixel 8) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/124.0.0.0 Mobile Safari/537.36"),
}

# ---------------------------------------------------------------------------
# 多账号配置模型
#   main section: 全局参数（base_url / interval / 定时重启接口）
#   account section: 每个账号绑定一个网络接口，独立认证
# ---------------------------------------------------------------------------

class Account:
    """单个校园网账号：绑定一个网络接口，独立认证。"""

    def __init__(self, name, interface, username, password,
                 device_type="windows", device_ua="", auto_rebind=False,
                 enabled=True):
        self.name = name
        self.interface = interface
        self.username = username
        self.password = password
        self.device_type = device_type
        self.device_ua = device_ua
        self.auto_rebind = auto_rebind
        self.enabled = enabled
        self.mac = _get_iface_mac(interface)
        # 自定义 UA 非空时优先生效，否则按终端类型预设
        self.ua = device_ua or UA_PRESETS.get(device_type, UA_PRESETS["windows"])

    def __repr__(self):
        return "Account(%s iface=%s user=%s)" % (
            self.name, self.interface, _mask_account(self.username))


def _get_iface_mac(iface):
    """获取指定网络接口的 MAC 地址，失败返回空串。"""
    if not _valid_iface_name(iface):
        return ""
    try:
        with open("/sys/class/net/%s/address" % iface) as f:
            mac = f.read().strip()
        if mac and mac.lower() != "00:00:00:00:00:00":
            return mac
    except OSError:
        pass
    return ""


def _iface_ipv4(iface):
    """读取接口当前 IPv4 地址（ioctl SIOCGIFADDR），失败返回空串。

    SO_BINDTODEVICE 只决定出接口，源地址仍由全局路由表挑选：mwan3 多 WAN 下
    本机发出的包会落到 main 表，默认路由 metric 偏斜到别的 WAN，导致源地址与
    出接口不一致、认证流量被上游丢弃。显式绑定该接口的源 IPv4 可避免此问题。
    仅 Linux 提供 fcntl/SIOCGIFADDR；其他平台（如测试环境）或接口无地址时返回
    空串，调用方退化为「只绑定出接口」的旧行为。"""
    if not _valid_iface_name(iface):
        return ""
    try:
        import fcntl
    except ImportError:
        return ""
    sock = None
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        req = struct.pack("256s", iface[:15].encode("utf-8"))
        res = fcntl.ioctl(sock.fileno(), 0x8915, req)  # SIOCGIFADDR
        return socket.inet_ntoa(res[20:24])
    except OSError:
        return ""
    finally:
        if sock is not None:
            sock.close()


def _route_dev(host, iface=None):
    """Return the output device for host (optionally constrained to iface).

    None means the ip command is unavailable, "" means no route.
    """
    if not host:
        return None
    cmd = ["ip", "-4", "route", "get", host]
    if iface:
        cmd += ["oif", iface]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None
    if p.returncode != 0:
        return ""
    m = re.search(r"\bdev\s+(\S+)", p.stdout or "")
    return m.group(1) if m else ""


def _iface_gateway(iface):
    """返回接口当前默认网关；读不到时返回空串。"""
    if not _valid_iface_name(iface):
        return ""
    try:
        p = subprocess.run(
            ["ip", "-4", "route", "show", "default", "dev", iface],
            capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    if p.returncode != 0:
        return ""
    m = re.search(r"\bvia\s+(\S+)", p.stdout or "")
    return m.group(1) if m else ""


def _neighbor_state(iface, gateway):
    """返回指定接口上网关邻居项的状态；没有邻居项时返回空串。

    mwan2 这类 macvlan 如果上游端口只允许一个 MAC，网关 ARP 会长期停在
    INCOMPLETE/FAILED。此时即使路由表里有一条默认路由，绑定该接口的 TCP
    connect 也会 EHOSTUNREACH；提前发现并跳过本轮认证，可避免改走默认路由
    把请求从别的 WAN 发出去（Portal 会把它当成同账号异常来源并限流）。
    """
    if not _valid_iface_name(iface) or not gateway:
        return ""
    try:
        p = subprocess.run(
            ["ip", "-4", "neigh", "show", "dev", iface],
            capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    if p.returncode != 0:
        return ""
    for line in (p.stdout or "").splitlines():
        fields = line.split()
        if not fields or fields[0] != gateway:
            continue
        for state in ("INCOMPLETE", "FAILED", "PERMANENT", "REACHABLE",
                      "STALE", "DELAY", "PROBE"):
            if state in fields:
                return state
        return ""
    return ""


def _iface_ready(iface):
    """检查绑定接口是否可用于认证：存在、有 IPv4 地址、有路由、网关 ARP 正常。
    返回 (ready, reason)：ready=True 时 reason 为空串；否则给出简短原因。
    iface 为空（未绑定接口）时视为就绪——沿用「由系统默认出口发包」的行为。
    """
    if not iface:
        return True, ""
    if not _valid_iface_name(iface):
        return False, "接口名非法"
    if not os.path.exists("/sys/class/net/%s" % iface):
        return False, "接口 %s 不存在" % iface
    if not _iface_ipv4(iface):
        return False, "接口 %s 尚无 IPv4 地址（未 DHCP 或未 up）" % iface

    host = urllib.parse.urlsplit(BASE_URL).hostname
    if host:
        dev = _route_dev(host, iface)
        if dev == "":
            return False, "接口 %s 暂无到 Portal %s 的路由（检查 WAN 默认网关）" % (iface, host)
        if dev and dev != iface:
            return False, "到 Portal %s 的路由出口是 %s，不是绑定接口 %s" % (host, dev, iface)

    gateway = _iface_gateway(iface)
    state = _neighbor_state(iface, gateway) if gateway else ""
    if state in ("INCOMPLETE", "FAILED"):
        # The neighbor entry may be stale after an interface flap.  Send one
        # short probe to refresh it before declaring the interface unusable.
        try:
            subprocess.run(
                ["ping", "-c", "1", "-W", "1", "-I", iface, gateway],
                capture_output=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            pass
        state = _neighbor_state(iface, gateway)
    if state in ("INCOMPLETE", "FAILED"):
        return (False,
                "接口 %s 的网关 %s ARP %s（检查 macvlan/VLAN/上游端口是否允许该 MAC）"
                % (iface, gateway, state))

    return True, ""


# 运行期全局配置（main section）
BASE_URL = "http://10.189.1.3"
INTERVAL = 30
IFACE_RESTART_ENABLED = False
IFACE_RESTART_TIME = ""
ENABLED = True
UA3F_SYNC_UA = ""  # 全局配置：同步给 UA3F 的 UA（空则不动 UA3F）

# UA3F 作用于路由器全局转发流量（ua3f.main.ua 为单值），无法按接口区分，
# 故其 UA 独立于各账号的认证 UA，且仅在保存配置时同步一次（见 sync-ua3f 子命令）。


def _pick_opt(section, key, default):
    """从 UCI section 字典取值，空值回退默认值。"""
    v = section.get(key)
    if v is not None and v != "":
        return v
    return default


def _load_global_cfg():
    """加载 main section 全局配置。"""
    global BASE_URL, INTERVAL, IFACE_RESTART_ENABLED, IFACE_RESTART_TIME, \
        ENABLED, UA3F_SYNC_UA
    sections = _load_uci_config()
    main = sections.get("main", {})
    BASE_URL = _pick_opt(main, "base_url", "http://10.189.1.3").rstrip("/")
    try:
        INTERVAL = int(_pick_opt(main, "interval", "30"))
    except ValueError:
        INTERVAL = 30
    if INTERVAL < 10:
        INTERVAL = 10
    IFACE_RESTART_ENABLED = _pick_opt(main, "iface_restart_enabled", "0").lower() in ("1", "true", "yes", "on")
    IFACE_RESTART_TIME = _pick_opt(main, "iface_restart_time", "04:00")
    ENABLED = _pick_opt(main, "enabled", "0").lower() in ("1", "true", "yes", "on")
    UA3F_SYNC_UA = _pick_opt(main, "ua3f_sync_ua", "")


def _load_accounts():
    """加载所有 account section，返回 Account 列表（仅含已启用的）。
    接口唯一：同一接口只能被一个账号绑定，重复绑定的后来者跳过并告警。"""
    sections = _load_uci_config()
    accounts = []
    iface_owner = {}
    for name, sec in sections.items():
        if sec.get(".type") != "account":
            continue  # 只处理 account section（跳过 main 等非账号段）
        if _pick_opt(sec, "enabled", "1").lower() not in ("1", "true", "yes", "on"):
            continue
        iface = sec.get("interface", "")
        username = sec.get("username", "")
        password = sec.get("password", "")
        if not username or not password:
            continue  # 账号密码不完整跳过
        if iface and not _valid_iface_name(iface):
            print("[giwifi-auth] 账号 %s 的接口名非法，跳过" % name, flush=True)
            continue
        if iface and iface in iface_owner:
            print("[giwifi-auth] 接口 %s 已被账号 %s 绑定，跳过账号 %s"
                  "（同一接口不可被多个账号绑定）"
                  % (iface, iface_owner[iface], name), flush=True)
            continue
        if iface:
            iface_owner[iface] = name
        acc = Account(
            name=name,
            interface=iface,
            username=username,
            password=password,
            device_type=_pick_opt(sec, "device_type", "windows").lower(),
            device_ua=sec.get("device_ua", ""),
            auto_rebind=_pick_opt(sec, "auto_rebind", "0").lower() in ("1", "true", "yes", "on"),
            enabled=True,
        )
        accounts.append(acc)
    return accounts


def cmd_check_config():
    """接口唯一性校验：同一接口只能被一个账号绑定。
    打印所有冲突；返回 0=无冲突, 1=存在冲突（供 LuCI 保存后校验调用）。"""
    _refresh_cfg()
    sections = _load_uci_config()
    iface_owner = {}
    conflicts = []
    for name, sec in sections.items():
        if sec.get(".type") != "account":
            continue  # 只处理 account section（跳过 main 等非账号段）
        iface = sec.get("interface", "")
        if not iface:
            continue
        if iface in iface_owner:
            conflicts.append((iface, iface_owner[iface], name))
        else:
            iface_owner[iface] = name
    for iface, a, b in conflicts:
        print("接口 %s 同时被账号 %s 与 %s 绑定" % (iface, a, b), flush=True)
    return 1 if conflicts else 0


def _refresh_cfg(stop_if_disabled=False):
    """刷新全局配置；stop_if_disabled 时若全局禁用则停止守护。"""
    _load_global_cfg()
    if stop_if_disabled and not ENABLED:
        print("[giwifi-auth] 配置已禁用（enabled=0），停止守护", flush=True)
        try:
            subprocess.run(["/etc/init.d/giwifi-auth", "stop"],
                           capture_output=True, text=True, timeout=10)
        except Exception:
            pass
        os._exit(0)


def _sync_ua3f():
    """把全局配置 ua3f_sync_ua 同步到 UA3F（若已安装且值不同，则 set + commit + restart）。
    ua3f_sync_ua 为终端类型键（windows/ipad/iphone/android），经 UA_PRESETS 映射为完整 UA；
    若填的已是完整 UA 字符串（含空格），则兼容旧值直接使用。取值为空则完全不动 UA3F。
    仅在保存配置时调用一次（见 sync-ua3f 子命令）。"""
    raw = UA3F_SYNC_UA
    if not raw:
        return
    ua = UA_PRESETS.get(raw, raw)  # 键则映射为预设 UA，否则按完整 UA 字符串使用
    try:
        p = subprocess.run(["uci", "get", "ua3f.main.ua"],
                           capture_output=True, text=True, timeout=5)
    except Exception:
        return
    if p.returncode != 0 or not p.stdout.strip():
        return  # ua3f 未安装或未配置，跳过
    cur = p.stdout.strip()
    if cur == ua:
        return  # 已一致，幂等
    try:
        subprocess.run(["uci", "set", "ua3f.main.ua=" + ua],
                       capture_output=True, text=True, timeout=5)
        subprocess.run(["uci", "commit", "ua3f"],
                       capture_output=True, text=True, timeout=5)
        subprocess.run(["/etc/init.d/ua3f", "restart"],
                       capture_output=True, text=True, timeout=15)
    except Exception:
        return
    print("UA3F 联动: UA 已同步为终端类型 %s" % raw if raw in UA_PRESETS
          else "UA3F 联动: UA 已同步", flush=True)


_refresh_cfg()


# ---------------------------------------------------------------------------
# 纯 Python AES-128（与桌面脚本同一实现，已实测）
# 密钥固定为 WEB_AES_KEY，round_keys 在模块加载时预计算一次。
# ---------------------------------------------------------------------------
_AES_SBOX = [
    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
