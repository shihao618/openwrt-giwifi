#!/bin/sh
# GiWiFi native ECMP load balancing.
#
# Account authentication sockets bind SO_BINDTODEVICE and their WAN source
# address directly, so no per-account route table or source-address ip rule
# is needed.  LAN traffic (including UA3F's proxied sockets) simply uses the
# native ECMP default route built from the healthy account interfaces.
#
# This file is intentionally independent of mwan3: mwan3 must be disabled
# when native ECMP mode is used.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

STATE_DIR=/tmp/giwifi-policy
STATE_FILE=$STATE_DIR/state
DESIRED_FILE=$STATE_DIR/desired
LOG_TAG=giwifi-policy
POLICY_LOCK=/var/run/giwifi-policy.lock

# Serialize apply/cleanup: two account threads can change readiness at the
# same time (e.g. after ARP recovery), and concurrent generation rewrites can
# otherwise leave the ECMP default with only one nexthop (100M instead of
# aggregated bandwidth).
exec 9>"$POLICY_LOCK"
if ! flock -n 9; then
    logger -t "$LOG_TAG" "another policy generation is running; skip" 2>/dev/null || true
    exit 0
fi

log() {
    logger -t "$LOG_TAG" "$*" 2>/dev/null || true
}

cleanup_ecmp() {
    # Only remove our multipath default; plain netifd defaults are kept.
    if ip route show default 2>/dev/null | grep -q 'nexthop'; then
        ip route del default 2>/dev/null || true
    fi
}

cleanup_all() {
    # Remove old source rules/tables from pre-2.1.11 generations.  New
    # generations do not create them.
    if [ -f "$STATE_FILE" ]; then
        while IFS='|' read -r dev table src gw weight; do
            [ -n "$dev" ] || continue
            if [ -n "$src" ] && [ -n "$table" ]; then
                ip rule del from "$src" lookup "$table" priority 1000 2>/dev/null || true
            fi
            if [ -n "$table" ]; then
                ip route flush table "$table" 2>/dev/null || true
            fi
        done < "$STATE_FILE"
    fi
    # Old UA3F mark bypass from pre-2.1.11 generations.
    ip rule del fwmark 0xc9 lookup main priority 500 2>/dev/null || true
    cleanup_ecmp
    rm -rf "$STATE_DIR"
}

# Resolve the IPv4 gateway currently used by a device.
iface_gateway() {
    local dev="$1"
    ip -4 route show default 2>/dev/null \
        | grep -E " dev $dev( |$)" \
        | awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }' \
        | head -n 1
}

# Return 0 when the interface's gateway neighbor is unusable.
gateway_neighbor_bad() {
    local dev="$1" gw="$2" state
    [ -n "$gw" ] || return 0
    state=$(ip -4 neigh show dev "$dev" 2>/dev/null \
        | awk -v gw="$gw" '$1 == gw { for (i = 1; i <= NF; i++) if ($i == "INCOMPLETE" || $i == "FAILED") { print $i; exit } }')
    [ -n "$state" ]
}

# Resolve the first global IPv4 prefix of a device.
iface_cidr() {
    local dev="$1"
    ip -4 -o addr show dev "$dev" scope global 2>/dev/null \
        | awk '{ print $4; exit }'
}

_collect_account() {
    local cfg="$1" enabled iface username password weight cidr gw

    config_get_bool enabled "$cfg" enabled 1
    [ "$enabled" = "1" ] || return 0

    config_get username "$cfg" username ''
    config_get password "$cfg" password ''
    [ -n "$username" ] && [ -n "$password" ] || return 0

    config_get iface "$cfg" interface ''
    [ -n "$iface" ] || return 0
    case "$iface" in
        -*|*[!A-Za-z0-9_.:-]*) return 0 ;;
    esac
    [ -e "/sys/class/net/$iface" ] || return 0

    # Each interface has exactly one ECMP nexthop.
    case " $desired_devs " in
        *" $iface "*) return 0 ;;
    esac

    cidr=$(iface_cidr "$iface")
    [ -n "$cidr" ] || return 0

    gw=$(iface_gateway "$iface")
    [ -n "$gw" ] || return 0

    # Do not put a WAN into ECMP when its gateway ARP is already known bad:
    # LAN/UA3F traffic would be hashed onto a dead nexthop and fail with
    # EHOSTUNREACH.  A short ping refreshes a stale/INCOMPLETE entry first.
    if gateway_neighbor_bad "$iface" "$gw"; then
        ping -c 1 -W 1 -I "$iface" "$gw" >/dev/null 2>&1 || true
    fi
    if gateway_neighbor_bad "$iface" "$gw"; then
        log "skip $iface: gateway $gw ARP is unusable"
        return 0
    fi

    config_get weight "$cfg" weight 1
    case "$weight" in
        ''|*[!0-9]*) weight=1 ;;
    esac
    [ "$weight" -gt 0 ] 2>/dev/null || weight=1
    [ "$weight" -gt 100 ] 2>/dev/null && weight=100

    desired_devs="$desired_devs $iface"
    desired_count=$((desired_count + 1))
    # Keep the historical five-field state format; table/src are empty in
    # the current generation and only used by cleanup of old generations.
    printf '%s|||%s|%s\n' "$iface" "$gw" "$weight" >> "$DESIRED_FILE"
}

apply_all() {
    local main_enabled ecmp_enabled count dev table src gw weight

    mkdir -p "$STATE_DIR" || exit 1

    # Include L4 ports in the multipath hash.  With the default L3-only
    # hash, concurrent connections to the same server all stick to one WAN.
    if [ -w /proc/sys/net/ipv4/fib_multipath_hash_policy ]; then
        echo 1 > /proc/sys/net/ipv4/fib_multipath_hash_policy 2>/dev/null || true
    fi

    # Remove the old UA3F mark bypass from pre-2.1.11 generations.  Auth
    # sockets use SO_BINDTODEVICE + source binding; LAN/UA3F traffic uses
    # the plain ECMP default, so no fwmark rule is needed anymore.
    ip rule del fwmark 0xc9 lookup main priority 500 2>/dev/null || true

    # Native ECMP and mwan3 policy routing cannot safely coexist.
    if pgrep -f '[m]wan3' >/dev/null 2>&1; then
        log 'mwan3 is running; native ECMP is disabled until mwan3 is stopped'
        cleanup_all
        return 0
    fi

    . /lib/functions.sh 2>/dev/null || true
    config_load 'giwifi-auth' 2>/dev/null || {
        cleanup_all
        return 0
    }

    config_get_bool main_enabled 'main' enabled 0
    config_get_bool ecmp_enabled 'main' ecmp_enabled 1

    if [ "$main_enabled" != "1" ]; then
        cleanup_all
        return 0
    fi

    : > "$DESIRED_FILE"
    desired_devs=''
    desired_count=0

    config_foreach _collect_account account

    # Remove the previous generation's source rules/tables.  New generations
    # only install the ECMP default and no per-account policy rules.
    if [ -f "$STATE_FILE" ]; then
        while IFS='|' read -r dev table src gw weight; do
            [ -n "$dev" ] || continue
            if [ -n "$src" ] && [ -n "$table" ]; then
                ip rule del from "$src" lookup "$table" priority 1000 2>/dev/null || true
            fi
            if [ -n "$table" ]; then
                ip route flush table "$table" 2>/dev/null || true
            fi
        done < "$STATE_FILE"
    fi

    cp "$DESIRED_FILE" "$STATE_FILE"

    count=$(grep -c '|' "$STATE_FILE" 2>/dev/null)
    [ -n "$count" ] || count=0
    if [ "$ecmp_enabled" = "1" ] && [ "$count" -ge 2 ]; then
        set --
        while IFS='|' read -r dev table src gw weight; do
            [ -n "$dev" ] || continue
            set -- "$@" nexthop via "$gw" dev "$dev" weight "$weight"
        done < "$STATE_FILE"
        ip route replace default "$@" 2>/dev/null || {
            log 'failed to install ECMP default route'
            cleanup_ecmp
        }
    else
        cleanup_ecmp
    fi

    rm -f "$DESIRED_FILE"
}

case "$1" in
    apply|sync)
        apply_all
        ;;
    cleanup)
        cleanup_all
        ;;
    *)
        echo "usage: $0 apply|cleanup" >&2
        exit 1
        ;;
esac
